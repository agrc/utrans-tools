{
  "python-envs.defaultEnvManager": "ms-python.python:conda",
  "files.associations": {
    "*.arcade": "javascript"
  },
  "vitest.rootConfig": "${workspaceFolder}/attribute-rules/vitest.config.ts",
  "cSpell.words": [
    "ACCESSCODE",
    "ALTROADNAME",
    "ALTROADTYPE",
    "arcgis",
    "arcgispro",
    "arcpy",
    "boxelder",
    "CARTOCODE",
    "daggett",
    "daml",
    "duchesne",
    "fips",
    "FROMADDR",
    "geodatabase",
    "Geospatial",
    "HWYNAM",
    "MVVM",
    "ONEWAY",
    "pathspec",
    "POSTDIR",
    "POSTTYPE",
    "posttypes",
    "PREDIR",
    "pyproject",
    "pytest",
    "pythonpath",
    "recents",
    "ROADALIASNAME",
    "saltlake",
    "Sevier",
    "SGID",
    "SRFTYP",
    "STREETNAME",
    "SUFDIR",
    "SUFFIXDIR",
    "testpaths",
    "TOADDR",
    "Tooele",
    "TRANSADMIN",
    "UGRC",
    "Uintah",
    "utrans",
    "UTRANS",
    "vecc"
  ],
  "python.testing.pytestArgs": ["cli"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "chat.tools.terminal.autoApprove": {
    "/^dotnet build add-in\\\\UGRC\\.UtransTools\\\\UGRC\\.UtransTools\\.csproj --no-restore$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^conda activate utrans-tools$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^conda activate utrans-tools; pytest[^;]*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^conda activate utrans-tools; ruff[^;]*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^dotnet build \\.\\\\add-in\\\\UGRC\\.UtransTools\\\\UGRC\\.UtransTools\\.csproj --configuration Debug$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^Set-Location 'C:\\\\projects\\\\utrans-tools'; dotnet test 'add-in\\\\UGRC\\.UtransTools\\.Core\\.Tests\\\\UGRC\\.UtransTools\\.Core\\.Tests\\.csproj'$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^dotnet test add-in\\\\UGRC\\.UtransTools\\.Core\\.Tests\\\\UGRC\\.UtransTools\\.Core\\.Tests\\.csproj$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^dotnet build \"add-in\\\\UGRC\\.UtransTools\\\\UGRC\\.UtransTools\\.csproj\" --configuration Debug --no-restore$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^dotnet build add-in\\\\UGRC\\.UtransTools\\\\UGRC\\.UtransTools\\.csproj --configuration Debug --no-restore --verbosity minimal$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },
  "[xml]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },
  "[xaml]": {
    "editor.formatOnSave": false
  },
  "[python]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false
  },
  "[javascript]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.detectIndentation": false
  },
  "editor.formatOnSave": true,
  "python-envs.defaultPackageManager": "ms-python.python:conda"
}
