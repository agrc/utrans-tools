/* global $feature */
// FIELD: NAME
// EVENTS: INSERT, UPDATE
// Trim NAME and collapse accidental internal whitespace.
// Test case: NAME="  NORTH   MAIN  " -> "NORTH MAIN"

var value = Trim(IIf(IsEmpty($feature.NAME), "", Text($feature.NAME)));
while (Find("  ", value) > -1) {
  value = Replace(value, "  ", " ");
}

return value;
