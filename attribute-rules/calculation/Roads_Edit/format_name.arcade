/* global $feature, $datastore, $layer, $map, FeatureSetByName, IIf, Buffer */
// FIELD: NAME
// EVENTS: INSERT, UPDATE
// Remove apostrophes and normalize NAME to uppercase on CREATE and UPDATE events
// Test case: NAME="O'Connell" -> "OCONNELL"
var name = IIf(IsEmpty($feature.NAME), "", Text($feature.NAME));
return Upper(Replace(name, "'", ""));