/* global $feature, $datastore, $layer, $map, FeatureSetByName, IIf, Buffer */
// FIELD:
// EVENTS: INSERT, UPDATE
Expects($feature, 'DOT_RTNAME');

var addressSystemQuadrantsLayer = FeatureSetByName($datastore, "AddressSystemQuadrants", ["QUADRANT", "GRID_NAME"]);
var countyLayer = FeatureSetByName($datastore, "Counties", ["FIPS_STR", "NAME"]);
var zipCodeLayer = FeatureSetByName($datastore, "ZipCodes", ["ZIP5", "NAME"]);
var municipalityLayer = FeatureSetByName($datastore, "Municipalities", ["NAME"]);

var roadLeft = Centroid(Offset($feature, -15, 'meters', 'square'), 'labelPoint');
var roadRight = Centroid(Offset($feature, 15, 'meters', 'square'), 'labelPoint');

function fieldOrNull(feature, fieldName) {
  if (IsEmpty(feature)) {
    return null;
  }

  return feature[fieldName];
}

function dotOwner(municipalityFeature, countyFeature) {
  if (!IsEmpty(municipalityFeature)) {
    return 'MU ' + municipalityFeature.NAME;
  }

  if (!IsEmpty(countyFeature)) {
    return 'CO ' + Proper(countyFeature.NAME);
  }

  return '';
}

var quadrantLeftFeature = First(Intersects(addressSystemQuadrantsLayer, roadLeft));
var quadrantRightFeature = First(Intersects(addressSystemQuadrantsLayer, roadRight));
var countyLeftFeature = First(Intersects(countyLayer, roadLeft));
var countyRightFeature = First(Intersects(countyLayer, roadRight));
var zipCodeLeftFeature = First(Intersects(zipCodeLayer, roadLeft));
var zipCodeRightFeature = First(Intersects(zipCodeLayer, roadRight));
var municipalityLeftFeature = First(Intersects(municipalityLayer, roadLeft));
var municipalityRightFeature = First(Intersects(municipalityLayer, roadRight));

var dotRtName = Trim(IIf(IsEmpty($feature.DOT_RTNAME), '', Text($feature.DOT_RTNAME)));
var dotOwnL = '';
var dotOwnR = '';
if (Left(dotRtName, 1) == '0') {
  dotOwnL = 'UDOT';
  dotOwnR = 'UDOT';
} else {
  dotOwnL = dotOwner(municipalityLeftFeature, countyLeftFeature);
  dotOwnR = dotOwner(municipalityRightFeature, countyRightFeature);
}

return {
  "result": {
    "attributes": {
      "QUADRANT_L": fieldOrNull(quadrantLeftFeature, "QUADRANT"),
      "QUADRANT_R": fieldOrNull(quadrantRightFeature, "QUADRANT"),
      "COUNTY_L": fieldOrNull(countyLeftFeature, "FIPS_STR"),
      "COUNTY_R": fieldOrNull(countyRightFeature, "FIPS_STR"),
      "ADDRSYS_L": Proper(fieldOrNull(quadrantLeftFeature, "GRID_NAME")),
      "ADDRSYS_R": Proper(fieldOrNull(quadrantRightFeature, "GRID_NAME")),
      "POSTCOMM_L": fieldOrNull(zipCodeLeftFeature, "NAME"),
      "POSTCOMM_R": fieldOrNull(zipCodeRightFeature, "NAME"),
      "ZIPCODE_L": fieldOrNull(zipCodeLeftFeature, "ZIP5"),
      "ZIPCODE_R": fieldOrNull(zipCodeRightFeature, "ZIP5"),
      "INCMUNI_L": fieldOrNull(municipalityLeftFeature, "NAME"),
      "INCMUNI_R": fieldOrNull(municipalityRightFeature, "NAME"),
      "DOT_OWN_L": dotOwnL,
      "DOT_OWN_R": dotOwnR
    }
  }
}
