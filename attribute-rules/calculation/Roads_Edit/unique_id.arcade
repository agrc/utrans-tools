/* global $feature, $datastore, $layer, $map, FeatureSetByName, Intersects, First, Point, IIf, Buffer, Expects, Geometry, IsEmpty, Trim, Text, Count, Sqrt, Floor, Find, Mid, Replace */
// Ports the legacy UtransEditor getNewUniqueID logic, reading GRID1MIL/GRID100K from the
// NationalGrid layer now included in this geodatabase instead of computing them mathematically.
// Grid-cell zone mismatches at the UTM 11/12 boundary are ignored since this ID is only eyeballed, not parsed.
Expects($feature, 'NAME', 'POSTDIR', 'POSTTYPE', 'UNIQUE_ID');

var DIGITS = '0123456789';

function distance2d(from, to) {
	var dx = to.x - from.x;
	var dy = to.y - from.y;

	return Sqrt(dx * dx + dy * dy);
}

// Arcade has no linear referencing, so walk the vertices to find the point halfway along the line.
function midpointAlongLine(geometry) {
	var paths = geometry.paths;
	if (IsEmpty(paths) || Count(paths) == 0) {
		return null;
	}

	var total = 0;
	for (var p in paths) {
		var path = paths[p];
		for (var v = 1; v < Count(path); v++) {
			total += distance2d(path[v - 1], path[v]);
		}
	}

	var first = paths[0][0];
	if (total == 0) {
		return { 'x': first.x, 'y': first.y };
	}

	var target = total / 2;
	var traveled = 0;
	for (var i in paths) {
		var current = paths[i];
		for (var j = 1; j < Count(current); j++) {
			var start = current[j - 1];
			var end = current[j];
			var length = distance2d(start, end);

			if (length > 0) {
				if (traveled + length >= target) {
					var ratio = (target - traveled) / length;

					return {
						'x': start.x + (end.x - start.x) * ratio,
						'y': start.y + (end.y - start.y) * ratio
					};
				}

				traveled += length;
			}
		}
	}

	return { 'x': first.x, 'y': first.y };
}

// Rounds half up to match the legacy "+ .5 then cast to long" behavior.
function trimCoordinate(value, leading) {
	var digits = Text(Floor(value + 0.5));

	return Mid(digits, leading, Count(digits) - leading - 1);
}

function isWholeNumber(value) {
	if (value == '') {
		return false;
	}

	for (var i = 0; i < Count(value); i++) {
		if (Find(Mid(value, i, 1), DIGITS) == -1) {
			return false;
		}
	}

	return true;
}

// NAME/POSTDIR/POSTTYPE are read directly because attribute rule execution order is not guaranteed,
// so FULLNAME may still hold the pre-edit value.
function nameSuffix() {
	var name = Trim(IIf(IsEmpty($feature.NAME), '', Text($feature.NAME)));
	if (name == '') {
		return '';
	}

	var postdir = Trim(IIf(IsEmpty($feature.POSTDIR), '', Text($feature.POSTDIR)));
	var posttype = Trim(IIf(IsEmpty($feature.POSTTYPE), '', Text($feature.POSTTYPE)));
	var suffix = IIf(isWholeNumber(name), postdir, posttype);

	var value = '_' + name;
	if (suffix != '') {
		value += '_' + suffix;
	}

	return Replace(value, ' ', '_');
}

var geometry = Geometry($feature);
if (IsEmpty(geometry)) {
	return $feature.UNIQUE_ID;
}

var midpoint = midpointAlongLine(geometry); // look up centroid in arcade 
if (IsEmpty(midpoint)) {
	return $feature.UNIQUE_ID;
}

// TODO: confirm this matches the NationalGrid layer's actual title in the geodatabase.
var midpointGeom = Point({ 'x': midpoint.x, 'y': midpoint.y, 'spatialReference': geometry.spatialReference });
var nationalGrid = FeatureSetByName($datastore, 'NationalGrid', ['GRID1MIL', 'GRID100K'], true);
var gridMatch = First(Intersects(nationalGrid, midpointGeom));
if (IsEmpty(gridMatch)) {
	return $feature.UNIQUE_ID; // throwing an error may be better here so that way the user knows that it's not being computed
}

var grid1mil = gridMatch.GRID1MIL;
var grid100k = gridMatch.GRID100K;

// Test case: midpoint 12T VK 3756 1234 on "GOLD KEY LN" -> "12TVK37561234_GOLD_KEY_LN"
// might need to cast? 
return Trim(grid1mil + grid100k + trimCoordinate(midpoint.x, 1) + trimCoordinate(midpoint.y, 2) + nameSuffix());
