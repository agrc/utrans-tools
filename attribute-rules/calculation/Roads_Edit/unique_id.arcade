/* global $feature, $datastore, $layer, $map, FeatureSetByName, Intersects, First, Centroid, IIf, Buffer, Expects, Geometry, IsEmpty, Trim, Text, Count, Floor, Mid, Replace */
// Ports the legacy UtransEditor getNewUniqueID logic, reading GRID1MIL/GRID100K from the USNG.
// Grid-cell zone mismatches at the UTM 11/12 boundary are ignored since this ID is only eyeballed, not parsed.
// FIELD: UNIQUE_ID
// EVENTS: INSERT, UPDATE
Expects($feature, 'NAME', 'POSTDIR', 'POSTTYPE', 'UNIQUE_ID');

// Rounds half up to match the legacy "+ .5 then cast to long" behavior.
function trimCoordinate(value, leading) {
  var digits = Text(Floor(value + 0.5));

  return Mid(digits, leading, Count(digits) - leading - 1);
}

// NAME/POSTDIR/POSTTYPE are computed directly because attribute rule execution order is not guaranteed,
// so FULLNAME may still hold the pre-edit value.
function nameSuffix() {
  var name = Upper(Trim(IIf(IsEmpty($feature.NAME), '', Text($feature.NAME))));
  if (name == '') {
    return '';
  }

  var postdir = Upper(Trim(IIf(IsEmpty($feature.POSTDIR), '', Text($feature.POSTDIR))));
  var posttype = Upper(Trim(IIf(IsEmpty($feature.POSTTYPE), '', Text($feature.POSTTYPE))));

  var value = '_' + name;
  if (posttype != '') {
    value += '_' + posttype;
  }
  if (postdir != '') {
    value += '_' + postdir;
  }

  return Replace(value, ' ', '_');
}

var geometry = Geometry($feature);
if (IsEmpty(geometry)) {
  return "ERR:MISSING_GEOMETRY";
}

var midpointGeom = Centroid(geometry, "labelPoint");
if (IsEmpty(midpointGeom)) {
  return "ERR:MISSING_MIDPOINT";
}

var nationalGrid = FeatureSetByName($datastore, 'NationalGrid', ['GRID1MIL', 'GRID100K'], true);
var gridMatch = First(Intersects(nationalGrid, midpointGeom));
if (IsEmpty(gridMatch)) {
  return "ERR:NO_GRID_MATCH";
}

var grid1mil = gridMatch.GRID1MIL;
var grid100k = gridMatch.GRID100K;

// Test case: midpoint 12T VK 3756 1234 on "GOLD KEY LN" -> "12TVK37561234_GOLD_KEY_LN"
return Upper(Trim(grid1mil + grid100k + trimCoordinate(midpointGeom.x, 1) + trimCoordinate(midpointGeom.y, 2) + nameSuffix()));
