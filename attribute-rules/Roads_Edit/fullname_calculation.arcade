/* global $feature, $datastore, $layer, $map, FeatureSetByName, IIf, Buffer */
// Emitted on: CREATE and UPDATE
var name = IIf(IsEmpty($feature.NAME), "", $feature.NAME);
name = Replace(name, "'", "");
var postdir = IIf(IsEmpty($feature.POSTDIR), "", $feature.POSTDIR);
var posttype = IIf(IsEmpty($feature.POSTTYPE), "", $feature.POSTTYPE);
var concatenated = name + " " + postdir + " " + posttype;
var fullname = Trim(Replace(Replace(concatenated, "  ", " "), "  ", " "));
return fullname;