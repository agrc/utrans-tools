/* global $feature, $datastore, $layer, $map, FeatureSetByName, IIf, Buffer */
var textFields = ['BIKE_L', 'BIKE_R', 'BIKE_PLN_L', 'BIKE_PLN_R', 'DOT_HWYNAM', 'DOT_RTNAME', 'DOT_RTPART'];
Expects($feature, 'BIKE_L', 'BIKE_R', 'BIKE_PLN_L', 'BIKE_PLN_R', 'DOT_HWYNAM', 'DOT_RTNAME', 'DOT_RTPART');
var updates = {};

for (var i in textFields) {
    var f = textFields[i];
    var val = $feature[f];
    
    // Convert empty/whitespace strings to null, leave valid values alone
    if (IsEmpty(Trim(val))) {
        updates[f] = null;
    } else {
        updates[f] = val;
    }
}

// "result" handles BIKE_L (the anchor), "attributes" handles the rest
return {
    "result": updates['BIKE_L'], 
    "attributes": updates
};
