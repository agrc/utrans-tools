/* global $feature, $datastore, $layer, $map, FeatureSetByName, IIf, Buffer */
var zeroFields = ['ADDRSYS_L', 'ADDRSYS_R'];
var textFields = ['PREDIR', 'NAME', 'POSTTYPE', 'POSTDIR', 'A1_NAME', 'A1_POSTTYPE', 'A2_NAME', 'A2_POSTTYPE', 'AN_NAME'];
Expects($feature, 'ADDRSYS_L', 'ADDRSYS_R', 'PREDIR', 'NAME', 'POSTTYPE', 'POSTDIR', 'A1_NAME', 'A1_POSTTYPE', 'A2_NAME', 'A2_POSTTYPE', 'AN_NAME');
var updates = {};

for (var i in zeroFields) {
	var zeroField = zeroFields[i];
	var zeroVal = $feature[zeroField];

	// Convert empty values to 0, leave valid values alone.
	if (IsEmpty(zeroVal)) {
		updates[zeroField] = 0;
	} else {
		updates[zeroField] = zeroVal;
	}
}

for (var j in textFields) {
	var textField = textFields[j];
	var textVal = $feature[textField];

	// Convert empty/whitespace strings to blank, leave valid values alone.
	if (IsEmpty(Trim(textVal))) {
		updates[textField] = "";
	} else {
		updates[textField] = textVal;
	}
}

// For calculation rules, "attributes" must be nested under "result".
return {
	"result": {
		"attributes": updates
	}
};
